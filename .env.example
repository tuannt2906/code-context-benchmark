# Copy to .env and fill in what you have. .env is git-ignored. Never commit keys.
# Claude via Claude Code CLI (provider "claude_cli") needs NO key: it uses your `claude` login.

# Optional: Anthropic API (provider "anthropic")
ANTHROPIC_API_KEY=

# Optional: free-tier control model via an OpenAI-compatible endpoint (provider "openai_compat")
# Pick ONE preset in configs/free_qwen7b.json ("openrouter" | "groq" | "gemini" | "huggingface" | "together")
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
TOGETHER_API_KEY=
# or a custom endpoint:
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
